# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.
# Los valores de Supabase local salen de: npx supabase status

# --- Entorno ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- Supabase ---
# Desde el host:
SUPABASE_URL=http://127.0.0.1:54321
# Desde los contenedores de docker-compose (api, worker):
SUPABASE_URL_DOCKER=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto firma JWT con HS256 (legado). Si está vacío se usa JWKS.
SUPABASE_JWT_SECRET=
# Conexión directa a Postgres (worker y tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_DOCKER=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- IA: Claude ---
# Sin clave la app arranca igual; las llamadas al LLM fallan con "falta ANTHROPIC_API_KEY".
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-haiku-5-5
LLM_QUALITY_MODEL=claude-sonnet-5-5

# --- Presupuesto diario de IA (USD, toda la plataforma) ---
AI_DAILY_BUDGET_USD=1.00

# --- Servicios internos ---
TTS_URL=http://127.0.0.1:8100
RENDERER_URL=http://127.0.0.1:8200

# --- Cloudflare R2 (S3 compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vitrina-dev

# --- Observabilidad (opcional en dev) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Web (Vite expone solo variables VITE_*) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8000
